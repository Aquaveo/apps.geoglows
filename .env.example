# GEOGloWS portal — environment variables
#
# Copy to `.env.local` and fill with your Supabase project values.
# Do not commit `.env.local` (it's in .gitignore).

# Supabase project URL — find under Settings → API in the dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — same dashboard page. Safe for browsers.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# As of v0.2.0 (Cognito → Supabase Auth migration), no other auth-related
# env vars are required. Sign-in providers (Google, GitHub, password) are
# configured in the Supabase dashboard, not here.
